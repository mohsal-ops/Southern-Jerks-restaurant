generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id                         String      @id @default(uuid())
  name                       String
  email                      String      @unique
  passwordHash               String
  status                     AdminStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt            DateTime?
  verificationToken          String?     @unique
  verificationTokenExpiresAt DateTime?
  approvedById               String?
  approvedAt                 DateTime?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt
  pendingEmail               String?
}

model Item {
  id                     String      @id @default(uuid())
  name                   String
  description            String?
  priceInCents           Int
  slug                   String      @unique
  isAvailableForPurchase Boolean     @default(true)
  featured               Boolean     @default(false)
  image                  String?
  typeId                 String
  isCaterable            Boolean     @default(false)
  cateringDescription    String?
  cateringPriceInCents   Int?
  type                   Types       @relation(fields: [typeId], references: [id])
  orders                 Order[]
  sideGroups             SideGroup[]
}

model User {
  id        String   @id @default(uuid()) @map("_id")
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Types {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  items     Item[]
}

model Location {
  id        String   @id @default(uuid())
  name      String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
}

model Post {
  id          String   @id @default(uuid()) @map("_id")
  title       String
  description String
  content     String?
  image       String
  createdAt   DateTime @default(now())
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String[]
  image     String?
  order     Int      @default(0)
  accent    String   @default("#c85a1e")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id               String   @id @default(uuid()) @map("_id")
  pricePaidInCents Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String
  productId        String
  product          Item     @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(uuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  status    String     @default("open")
  items     CartItem[]
}

model CartItem {
  id              String         @id @default(uuid())
  image           String?
  productId       String?
  name            String?
  orderType       String?
  pickupDay       DateTime?
  pickupTime      String?
  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?
  deliveryPlaceId String?
  apt             String?
  instructions    String?
  customerName    String?
  customerPhone   String?
  price           Int?
  quantity        Int?
  cartId          String
  cart            Cart           @relation(fields: [cartId], references: [id])
  sides           CartItemSide[]
}

model SideGroup {
  id        String        @id @default(uuid())
  itemId    String
  title     String
  type      SideGroupType
  required  Boolean       @default(false)
  maxSelect Int?
  createdAt DateTime      @default(now())
  item      Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options   SideOption[]
}

model SideOption {
  id           String    @id @default(uuid())
  sideGroupId  String
  label        String
  priceInCents Int?
  linkedItemId String?
  sideGroup    SideGroup @relation(fields: [sideGroupId], references: [id], onDelete: Cascade)
}

model CartItemSide {
  id           String   @id @default(uuid())
  cartItemId   String
  sideGroupId  String
  optionId     String
  label        String
  priceInCents Int?
  cartItem     CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  alt       String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  name      String
  review    String
  avatar    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model BusinessHours {
  id        String   @id @default(cuid())
  day       String
  dayIndex  Int      @unique
  open      Int?
  close     Int?
  updatedAt DateTime @updatedAt
}

model CateringRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  eventType String
  date      String
  guests    String
  notes     String?
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteImage {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  label     String
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

enum AdminStatus {
  PENDING_VERIFICATION
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum SideGroupType {
  RECOMMENDED
  NO
  EXTRA
  SPICE
  SIDE
}
